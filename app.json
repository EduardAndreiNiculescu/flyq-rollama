{
  "expo": {
    "name": "FlyQ",
    "slug": "flightflow",
    "scheme": "flyq",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flightflow.craiova.dev",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "enablePushNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "buildReactNativeFromSource": true
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ],
      "expo-widgets",
      [
        "expo-camera",
        {
          "cameraPermission": "FlyQ folosește camera ca să citească codul de pe cartea de îmbarcare.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FlyQ folosește busola telefonului ca să te ghideze pe hartă când camera nu poate recunoaște locul."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "FlyQ folosește senzorii de mișcare (pași, giroscop) ca să-ți urmărească poziția pe hartă."
        }
      ]
    ]
  }
}
